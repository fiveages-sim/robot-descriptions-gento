<?xml version="1.0"?>
<robot name="Gento Luna Head" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:property name="PI" value="3.1415926535897931"/>

	<!-- 2-DOF yaw/pitch from Luna CAD. Mount xyz+rpy (incl. +90° about X) is owned by torso. -->
	<xacro:macro name="head" params="collider:='simple'">
		<link name="head_link1">
			<inertial>
				<origin xyz="9.4918E-07 0.017441 -0.0043026"/>
				<mass value="0.7216"/>
				<inertia
						ixx="0.0011491" ixy="-2.3245E-08" ixz="-1.802E-09"
						iyy="0.00077345" iyz="-5.6833E-05" izz="0.0011134"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find gento_luna_description)/meshes/head/head_yaw.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find gento_luna_description)/meshes/head/head_yaw.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin xyz="0 0.02 0"/>
					<geometry>
						<cylinder length="0.06" radius="0.04"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="head_joint1" type="revolute">
			<origin xyz="0 0 0"/>
			<parent link="head_mount"/>
			<child link="head_link1"/>
			<axis xyz="0 0 1"/>
			<limit lower="-0.5236" upper="0.5236" effort="18" velocity="3.665"/>
		</joint>

		<link name="head_link2">
			<inertial>
				<origin xyz="0.052332 0.00010809 0.15733"/>
				<mass value="2.3905"/>
				<inertia
						ixx="0.0083456" ixy="-9.1023E-06" ixz="-0.0012055"
						iyy="0.010445" iyz="-3.2339E-06" izz="0.0071811"/>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file://$(find gento_luna_description)/meshes/head/head_pitch.glb"/>
				</geometry>
			</visual>
			<xacro:if value="${collider == 'convex'}">
				<collision>
					<geometry>
						<mesh filename="file://$(find gento_luna_description)/meshes/head/head_pitch.glb"/>
					</geometry>
				</collision>
			</xacro:if>
			<xacro:if value="${collider == 'simple'}">
				<collision>
					<origin xyz="0.05 0 0.12"/>
					<geometry>
						<box size="0.18 0.16 0.22"/>
					</geometry>
				</collision>
			</xacro:if>
		</link>

		<joint name="head_joint2" type="revolute">
			<origin xyz="0 0 0" rpy="-${PI/2} 0 0"/>
			<parent link="head_link1"/>
			<child link="head_link2"/>
			<axis xyz="0 0 1"/>
			<limit lower="-${PI/2}" upper="${PI/2}" effort="18" velocity="3.665"/>
		</joint>
	</xacro:macro>

</robot>
