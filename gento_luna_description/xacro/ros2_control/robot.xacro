<?xml version="1.0"?>
<robot name="gento_luna" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:arg name="ros2_control_hardware_type" default="mock_components"/>
	<xacro:arg name="gazebo" default="false"/>

	<xacro:include filename="$(find gento_luna_description)/xacro/robot.xacro"/>
	<xacro:include filename="$(find robot_common_launch)/xacro/ros2_control/simulation_hardware.xacro"/>
	<xacro:include filename="$(find m6_ccs_description)/xacro/ros2_control/interfaces.xacro"/>
	<xacro:include filename="$(find gento_luna_description)/xacro/ros2_control/body.xacro"/>

	<ros2_control name="gento_luna_system" type="system">
		<hardware>
			<xacro:simulation_hardware_plugin hardware_type="$(arg ros2_control_hardware_type)"/>
		</hardware>
		<xacro:body_interfaces/>
		<xacro:m6_interfaces name="left"/>
		<xacro:m6_interfaces name="right"/>
	</ros2_control>

	<xacro:if value="$(arg gazebo)">
		<gazebo>
			<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
				<parameters>$(find gento_luna_description)/config/ros2_control/common.yaml</parameters>
			</plugin>
		</gazebo>
	</xacro:if>
</robot>
