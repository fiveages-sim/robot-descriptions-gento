<?xml version="1.0" ?>
<robot name="Skye" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<!-- Component: head, waist, body (waist + head). isaac:=true hides camera/sensor meshes. -->
	<xacro:arg name="type" default="head"/>
	<xacro:arg name="collider" default="simple"/>
	<xacro:arg name="isaac" default="true"/>

	<xacro:if value="${'$(arg type)' == 'head'}">
		<link name="head_mount"/>
		<xacro:include filename="$(find gento_skye_description)/xacro/components/head.xacro"/>
		<xacro:head collider="$(arg collider)" isaac="$(arg isaac)"/>
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'waist'}">
		<link name="base_link"/>
		<xacro:include filename="$(find gento_skye_description)/xacro/components/waist.xacro"/>
		<xacro:waist collider="$(arg collider)" isaac="$(arg isaac)"/>
	</xacro:if>

	<xacro:if value="${'$(arg type)' == 'body'}">
		<link name="base_link"/>
		<xacro:include filename="$(find gento_skye_description)/xacro/components/waist.xacro"/>
		<xacro:waist collider="$(arg collider)" isaac="$(arg isaac)"/>
		<xacro:include filename="$(find gento_skye_description)/xacro/components/head.xacro"/>
		<xacro:head collider="$(arg collider)" isaac="$(arg isaac)"/>
	</xacro:if>
</robot>
