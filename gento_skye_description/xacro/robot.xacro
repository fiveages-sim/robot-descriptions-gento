<?xml version="1.0"?>
<robot name="Gento Skye" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- topology:=full (default): whole humanoid.
	     topology:=dual: arms-only tree rooted at arm_base (split_body / demo OCS2 planning). -->
	<xacro:arg name="topology" default="full"/>
	<xacro:arg name="collider" default="simple"/>
	<xacro:arg name="chassis_joints_movable" default="false"/>
	<xacro:arg name="eef_fixed_joints" default="false"/>
	<xacro:arg name="type" default=""/>
	<xacro:arg name="left_type" default=""/>
	<xacro:arg name="right_type" default=""/>
	<xacro:arg name="left_tcp_offset_xyz" default="0 0 0"/>
	<xacro:arg name="left_tcp_offset_rpy" default="0 0 0"/>
	<xacro:arg name="right_tcp_offset_xyz" default="0 0 0"/>
	<xacro:arg name="right_tcp_offset_rpy" default="0 0 0"/>

	<xacro:property name="topology_arg" value="$(arg topology)"/>
	<xacro:property name="type_arg" value="$(arg type)"/>
	<xacro:property name="left_type_arg" value="$(arg left_type)"/>
	<xacro:property name="right_type_arg" value="$(arg right_type)"/>
	<xacro:property name="effective_left_type" value="${left_type_arg if left_type_arg != '' else type_arg}"/>
	<xacro:property name="effective_right_type" value="${right_type_arg if right_type_arg != '' else type_arg}"/>

	<xacro:include filename="$(find m6_ccs_description)/xacro/eef_type_resolver.xacro"/>
	<xacro:set_side_eef_types side="left" type_key="${effective_left_type}"/>
	<xacro:set_side_eef_types side="right" type_key="${effective_right_type}"/>

	<xacro:unless value="${topology_arg == 'dual'}">
		<xacro:include filename="$(find fiveages_w2_common_description)/xacro/components/linkhou_s2_v2.xacro"/>
		<xacro:linkhou_s2 joints_movable="$(arg chassis_joints_movable)" collider="$(arg collider)"/>

		<xacro:include filename="$(find gento_skye_description)/xacro/components/waist.xacro"/>
		<xacro:waist collider="$(arg collider)"/>
		<xacro:include filename="$(find gento_skye_description)/xacro/components/head.xacro"/>
		<xacro:head collider="$(arg collider)"/>
	</xacro:unless>

	<xacro:if value="${topology_arg == 'dual'}">
		<link name="base_link"/>
		<link name="arm_base"/>
		<joint name="arm_base_joint" type="fixed">
			<parent link="base_link"/>
			<child link="arm_base"/>
		</joint>
	</xacro:if>

	<!-- CAD J1 at y=±0.2305 z=0.4335 on waist_Link_3; M6-CCS joint1 is 0.1745 along base Z
	     → DualArmMount y = ±(0.2305 - 0.1745) = ±0.056 -->
	<xacro:include filename="$(find m6_ccs_description)/xacro/arm_mount.xacro"/>
	<xacro:DualArmMount parent="arm_base"
		left_xyz="0 0.056 0.4335" right_xyz="0 -0.056 0.4335"/>

	<xacro:include filename="$(find m6_ccs_description)/xacro/arm.xacro"/>
	<xacro:M6_CCS name="left"
		tcp_offset_xyz="$(arg left_tcp_offset_xyz)"
		tcp_offset_rpy="$(arg left_tcp_offset_rpy)"/>
	<xacro:M6_CCS name="right" direction="-1"
		tcp_offset_xyz="$(arg right_tcp_offset_xyz)"
		tcp_offset_rpy="$(arg right_tcp_offset_rpy)"/>

	<xacro:include filename="$(find m6_ccs_description)/xacro/eefs.xacro"/>
	<xacro:EndEffectors
		eef_fixed_joints="$(arg eef_fixed_joints)"
		left_hand_type="${left_hand_type}"
		left_gripper_type="${left_gripper_type}"
		left_gripper_pad="${left_gripper_pad}"
		right_hand_type="${right_hand_type}"
		right_gripper_type="${right_gripper_type}"
		right_gripper_pad="${right_gripper_pad}"/>
</robot>
